APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Production: APP_ENV=production and APP_DEBUG=false (debug pages leak stack traces & config)
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Database
DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite
DB_FOREIGN_KEYS=true

# Sessions
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
# Production: set to true so the session cookie is only sent over HTTPS
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Cache & Queue
QUEUE_CONNECTION=database
CACHE_STORE=database

# Mail
MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Broadcasting
BROADCAST_CONNECTION=log

# Filesystem
FILESYSTEM_DISK=local

# Redis (optioneel, kan leeg blijven)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# AWS (optioneel, kan leeg blijven)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Frontend
VITE_APP_NAME="${APP_NAME}"

# --- Security-related settings (assignment Software Security) ---
# Admin account used by AdminUserSeeder. Leave ADMIN_PASSWORD empty to get a random
# one-time password printed by `php artisan db:seed`. Never commit real values.
ADMIN_EMAIL=admin@ehb.be
ADMIN_PASSWORD=
# Recipient of contact-form notifications
MAIL_ADMIN_ADDRESS=admin@ehb.be
# Level for the dedicated security audit log (storage/logs/security-*.log)
LOG_SECURITY_LEVEL=info
